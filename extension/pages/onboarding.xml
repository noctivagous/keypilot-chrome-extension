<?xml version="1.0" encoding="UTF-8"?>
<onboarding version="1">
  <slide id="basic_navigation" title="Welcome to KeyPilot">
   <onEnter type="overlay"
             title="Welcome to KeyPilot"
             message="We'll show you how to use KeyPilot one step at a time."
             primaryText="OK"
             secondaryText="Close"
             secondaryAction="close" />
       <task id="click_link" label="Hover over a link and press the `F` key to click it.">
      <when type="action" action="activate" target="link" />
    </task>
    <task id="go_back" label="To go back (history), press the `D` key.">
      <when type="action" action="back" />
    </task>
    <task id="keyboard_key_info" label="Notice the Keyboard Reference window below. Hover over one of its keys to see what it does.">
      <when type="action" action="hover" target="keyboardHelpKey" />
    </task>
    <!-- Turn-off step: while this is the next task, a large focus-colored arrow points at the
         ON/OFF segment's right edge. After OFF, a tip bubble points at the strip ("click again to turn on").
         (Former Alt+K step removed; re-enable is guided by the tip bubble, not a separate task.) -->
    <task id="toggle_extension_off" label="There is a control strip above that says `ON`. Click it to turn KeyPilot completely off.">
      <when type="action" action="toggleExtension" change="off" />
    </task>
  </slide>

  <slide id="text_box_mode" title="Text box mode">
    <onEnter type="overlay"
             title="KeyPilot is back on"
             message="Next up: text boxes."
             primaryText="OK"
             effect="marquee" />
    <task id="enter_text_mode" label="Click a text field to the right with `F` and it will receive typing.">
      <when type="mode" mode="text_focus" change="enter" />
    </task>
    <task id="exit_text_mode" label="Press `Escape` to exit the text box.">
      <when type="mode" mode="text_focus" change="exit" />
    </task>
  </slide>

  <slide id="scrolling" title="Scrolling the page">
    <onEnter type="overlay"
             title="That's all you need to browse the web with KeyPilot."
             message="Do you want to try out more keys?"
             primaryText="Yes, Continue"
             secondaryText="No, I'll Do It Later"
             secondaryAction="later"
             laterTitle="Return to this Tutorial with `Alt`+`T`"
             laterPrimaryText="OK, Close" />
    <task id="scroll_down" label="Scroll down with `V`.">
      <when type="action" action="scrollDown" />
    </task>
    <task id="scroll_up" label="Scroll up with `C`.">
      <when type="action" action="scrollUp" />
    </task>
    <task id="scroll_bottom" label="Go to the bottom of the page with `X`.">
      <when type="action" action="scrollBottom" />
    </task>
    <task id="scroll_top" label="Go to the top of the page with `Z`.">
      <when type="action" action="scrollTop" />
    </task>
  </slide>

  <slide id="tabs" title="Tabs">
    <task id="open_link_background_tab" label="Click a hyperlink into a new tab but don't open it (`G`).">
      <when type="action" action="activateNewTabBackground" target="link" />
    </task>
    <task id="open_link_new_tab" label="Click a hyperlink into a new tab (`B`).">
      <when type="action" action="activateNewTab" target="link" />
    </task>
    <task id="open_new_tab" label="Open a new tab (`T`).">
      <when type="action" action="newTab" />
    </task>
    <task id="move_tabs" label="Move between tabs left (`Q`).">
      <when type="action" action="tabLeft" />
    </task>
    
    <task id="move_tabs_2" label="Move between tabs right (`W`).">
      <when type="action" action="tabRight" />
    </task>
  </slide>
  
  <slide id="completion" title="Tutorial complete">
    <body>
You finished the tutorial and are ready to use KeyPilot.
    </body>
  </slide>
</onboarding>


