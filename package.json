{
  "name": "keypilot-chrome-extension",
  "version": "1.0.0",
  "description": "KeyPilot Chrome Extension",
  "type": "module",
  "main": "extension/build.js",
  "scripts": {
    "build": "cd extension && node build.js",
    "build:macro-builder": "cd extension && node build.js --macro-builder",
    "build:minify": "cd extension && node build.js --minify",
    "minify": "npm run build:minify",
    "package:opera": "node scripts/package-opera.mjs",
    "docs:screenshots": "node scripts/docs-screenshots/capture.mjs",
    "audit": "npm audit --omit=dev",
    "audit:all": "npm audit"
  },
  "dependencies": {
    "markdown-it": "^15.0.0",
    "query-selector-shadow-dom": "^1.0.1",
    "terser": "^5.36.0"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2"
  }
}
