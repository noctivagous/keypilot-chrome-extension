{
  "name": "keypilot-chrome-extension",
  "version": "1.0.0",
  "description": "KeyPilot Chrome Extension",
  "type": "module",
  "main": "extension/build.js",
  "scripts": {
    "build": "cd extension && node build.js",
    "build:minify": "cd extension && node build.js --minify",
    "build:manual": "cd extension && node archive/manual-concat-build/build.js",
    "minify": "npm run build:minify"
  },
  "dependencies": {
    "query-selector-shadow-dom": "^1.0.1",
    "terser": "^5.36.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
