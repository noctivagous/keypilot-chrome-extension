{
  "name": "keypilot-chrome-extension",
  "version": "1.0.0",
  "description": "KeyPilot Chrome Extension",
  "license": "MIT",
  "type": "module",
  "main": "extension/build.js",
  "scripts": {
    "build": "node scripts/sync-region-defaults.mjs && cd extension && node build.js",
    "build:release": "node scripts/sync-region-defaults.mjs && cd extension && node build.js --release",
    "build:firefox": "node scripts/sync-region-defaults.mjs && cd extension && node build.js --firefox",
    "build:firefox:release": "node scripts/sync-region-defaults.mjs && cd extension && node build.js --firefox --release",
    "build:macro-builder": "node scripts/sync-region-defaults.mjs && cd extension && node build.js --macro-builder",
    "build:minify": "node scripts/sync-region-defaults.mjs && cd extension && node build.js --minify",
    "minify": "npm run build:minify",
    "package:opera": "node scripts/package-opera.mjs",
    "package:chrome": "node scripts/package-chrome.mjs",
    "package:firefox": "node scripts/package-firefox.mjs",
    "package:firefox-source": "node scripts/package-source.mjs",
    "docs:screenshots": "node scripts/docs-screenshots/capture.mjs",
    "store:screenshots": "node scripts/store-screenshots/generate.mjs",
    "store:screenshots:serve": "node scripts/store-screenshots/capture.mjs",
    "store:screenshots:auto": "node scripts/store-screenshots/auto-capture.mjs",
    "debug:chrome": "node scripts/debug-chrome.mjs",
    "test:ui-flow": "node scripts/ui-flow/run.mjs",
    "fixtures:keyboard-layouts": "node scripts/generate-keyboard-layout-fixtures.mjs",
    "check:locales": "node scripts/sync-region-defaults.mjs --check && node scripts/check-locales.mjs",
    "web:locales": "node promo/web/locales/generate.mjs",
    "web:locales:check": "node promo/web/locales/generate.mjs --check",
    "test": "npm run check:locales && node --test --test-concurrency=1 test/*.test.js",
    "test:settings": "node --test --test-concurrency=1 test/settings-manager.test.js",
    "test:storage": "node --test --test-concurrency=1 test/storage.test.js",
    "audit": "npm audit --omit=dev",
    "audit:all": "npm audit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "markdown-it": "^15.0.0",
    "query-selector-shadow-dom": "^1.0.1",
    "terser": "^5.36.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "archiver": "^8.0.0",
    "chrome-remote-interface": "^0.34.0",
    "esbuild": "^0.28.2"
  }
}
