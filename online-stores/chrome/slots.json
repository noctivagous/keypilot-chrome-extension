{
  "store": "chrome",
  "listingDocs": "https://developer.chrome.com/docs/webstore/cws-dashboard-listing",
  "packageNote": "Chrome does not read store screenshots from the extension package. Upload generated PNGs in the Developer Dashboard per locale.",
  "screenshot": {
    "width": 1280,
    "height": 800,
    "maxPerLocale": 5,
    "cornerStyle": "square",
    "fullBleed": true
  },
  "copyLimits": {
    "headline": 64,
    "callout": 72
  },
  "captureDefaults": {
    "viewport": { "width": 1280, "height": 800 },
    "deviceScaleFactor": 1,
    "fixture": "scripts/store-screenshots/fixture.html",
    "pageApi": "scripts/store-screenshots/page-api.js",
    "screenshot": "viewport",
    "chromeUiLanguage": "match-locale",
    "extensionState": {
      "enabled": true
    }
  },
  "paths": {
    "copy": "chrome/copy",
    "templates": "chrome/templates",
    "captures": "chrome/captures",
    "generated": "generated/chrome"
  },
  "excludeLocales": ["en_GB"],
  "initialLocales": ["en"],
  "globalPromo": [
    {
      "id": "small",
      "localized": false,
      "width": 440,
      "height": 280,
      "template": "chrome/templates/promo/small.svg",
      "outputFile": "generated/chrome/promo/small.png"
    },
    {
      "id": "marquee",
      "localized": false,
      "width": 1400,
      "height": 560,
      "template": "chrome/templates/promo/marquee.svg",
      "outputFile": "generated/chrome/promo/marquee.png"
    }
  ],
  "slots": [
    {
      "id": "key-click-browsing",
      "order": 1,
      "kind": "screenshot",
      "localized": true,
      "width": 1280,
      "height": 800,
      "copyKey": "key-click-browsing",
      "template": "chrome/templates/screenshots/key-click-browsing.svg",
      "captureFile": "key-click-browsing.png",
      "outputFile": "01-key-click-browsing.png",
      "capture": {
        "open": "key-click-browsing",
        "hoverSelector": "#kp-store-local-nav",
        "showCursor": true,
        "requiredSelectors": [
          "#kp-store-local-nav",
          ".kpv2-focus, .kpv2-focus-overlay, .kpv2-focus-ring-intarget",
          ".kp-floating-keyboard-help",
          "#kp-store-shot-cursor"
        ]
      }
    },
    {
      "id": "keyboard-map",
      "order": 2,
      "kind": "screenshot",
      "localized": true,
      "width": 1280,
      "height": 800,
      "copyKey": "keyboard-map",
      "template": "chrome/templates/screenshots/keyboard-map.svg",
      "captureFile": "keyboard-map.png",
      "outputFile": "02-keyboard-map.png",
      "capture": {
        "open": "keyboard-map",
        "hoverSelector": "#kp-store-primary-link",
        "pinActionId": "PREVIEW_LINK_POPOVER",
        "requiredSelectors": [
          "#kp-store-primary-link",
          ".kp-floating-keyboard-help",
          ".kp-keybindings-popover"
        ]
      }
    },
    {
      "id": "customize-workflow",
      "order": 3,
      "kind": "screenshot",
      "localized": true,
      "width": 1280,
      "height": 800,
      "copyKey": "customize-workflow",
      "template": "chrome/templates/screenshots/customize-workflow.svg",
      "captureFile": "customize-workflow.png",
      "outputFile": "03-customize-workflow.png",
      "capture": {
        "open": "customize-workflow",
        "hoverSelector": ".kp-floating-keyboard-help [data-kp-slot=\"E\"]",
        "showCursor": true,
        "focusHover": false,
        "requiredSelectors": [
          ".kp-layout-config-panel",
          ".kp-floating-keyboard-help",
          "[data-kp-lib-tab='functions']",
          "[data-kp-item-id='CLOSE_TAB']",
          ".kp-cfg-item-inspecting",
          ".kp-layout-place-arrow",
          ".kp-place-preview",
          "#kp-store-shot-cursor"
        ]
      }
    },
    {
      "id": "walkthrough",
      "order": 4,
      "kind": "screenshot",
      "localized": true,
      "width": 1280,
      "height": 800,
      "copyKey": "walkthrough",
      "template": "chrome/templates/screenshots/walkthrough.svg",
      "captureFile": "walkthrough.png",
      "outputFile": "04-walkthrough.png",
      "capture": {
        "open": "walkthrough",
        "requiredSelectors": [
          ".kp-onboarding-panel",
          "[data-kp-onboarding-slide-id='basic_navigation']",
          "[data-kp-onboarding-body='true']",
          ".kp-floating-keyboard-help"
        ]
      }
    },
    {
      "id": "context-menu",
      "order": 5,
      "kind": "screenshot",
      "localized": true,
      "width": 1280,
      "height": 800,
      "copyKey": "context-menu",
      "template": "chrome/templates/screenshots/context-menu.svg",
      "captureFile": "context-menu.png",
      "outputFile": "05-context-menu.png",
      "capture": {
        "open": "context-menu",
        "requiredSelectors": [
          "#kp-store-context-menu",
          "[data-kp-store-ctx-keypilot]",
          "[data-kp-store-ctx-docs]",
          "[data-kp-store-ctx-settings]",
          "#kp-store-shot-cursor"
        ]
      }
    }
  ]
}
