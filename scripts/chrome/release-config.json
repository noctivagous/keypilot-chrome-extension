{
  "channelLabel": "Chrome",
  "description": "Browse the web with key-clicks. Activate hyperlinks with keyboard keys instead of mouse buttons.",
  "descriptionMaxLength": 132,
  "homepageUrl": "https://noctivagous.com/",
  "developer": {
    "name": "Noctivagous",
    "url": "https://noctivagous.com/"
  },
  "stagingDir": "dist/chrome",
  "zipDir": "dist",
  "zipNameTemplate": "keypilot-chrome-v{version}.zip",
  "iconSizes": ["16", "32", "48", "128"],
  "requiredGeneratedFiles": [
    "content-bundled.js",
    "frame-agent-bundled.js",
    "pages/docs-bundled.js",
    "pages/settings-bundled.js"
  ],
  "requiredRuntimeFiles": [
    "map-pan-bridge.js",
    "icons/icon16.png",
    "icons/icon32.png",
    "icons/icon48.png",
    "icons/icon128.png",
    "fonts/ROBOTECHGPRegular.ttf",
    "fonts/TitilliumTextRegular.otf",
    "fonts/TitilliumTextBold.ttf",
    "fonts/CubellanRegular.ttf",
    "fonts/EzarionRegular.ttf",
    "fonts/DosisBook.ttf"
  ],
  "virtualWarPaths": [
    "_favicon/*"
  ],
  "forbiddenFirstPartyMinJs": [
    "content-bundled.min.js"
  ],
  "exclude": [
    "build.js",
    "build-side-effects.js",
    "content-bundled.min.js",
    "content-bundled.esbuild.js",
    "frame-agent-bundled.esbuild.js",
    "popup-v1.html",
    "popup-v1.js",
    "README.md",
    "pages/docs.js",
    "pages/settings.js",
    "pages/text-mode-practice.html",
    "pages/text-mode-tutorial.html",
    "keyboard/**",
    "plans/**",
    "reference-info/**",
    "img/**",
    "tests/**",
    "test-pages/**",
    "icons/README.md",
    "icons/icon-source.png",
    "icons/icon.svg",
    "icons/icon76.png",
    "icons/icon256.png",
    "themes/**/README.md",
    ".DS_Store",
    "**/.DS_Store"
  ]
}
